{
    "name": "uniface-syntax-extension",
    "displayName": "uniface-syntax-extension",
    "description": "A VSCode extension for Uniface program language, with syntax highlighter and all powerful of VSCode resources",
    "version": "1.12.0",
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "format": "prettier --write .",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src",
        "test": "vscode-test",
        "release": "standard-version",
        "create:release": "vsce package"
    },
    "pricing": "Free",
    "main": "./dist/extension.js",
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "configuration": {
            "title": "Uniface",
            "properties": {
                "uniface.snippets.entryTemplate": {
                    "type": "string",
                    "editPresentation": "multilineText",
                    "default": ";|\n; Author: {{author}}\n; Date: {{date}}\n; Description: \n;\nentry {{entryName}}\n    params\n        string  pLsEntrada   : in\n        string  pLsSaida     : out\n                \\$t_ds_erro\\$  : out\n    endparams\n    variables\n        string  vDsContexto\n    endvariables\n\n    vDsContexto = \"%%^<\\$componentname>, <\\$trigger>, {{entryName}}\"\n\n    ; Enter your code here...\n\n    return 0\nend ;{{entryName}}",
                    "description": "Multiline text used to generate a new entry. Supports {{entryName}}, {{author}}, {{date}}, and VS Code snippet placeholders."
                },
                "uniface.snippets.operationTemplate": {
                    "type": "string",
                    "editPresentation": "multilineText",
                    "default": ";|\n; Author: {{author}}\n; Date: {{date}}\n; Description: \n;\noperation {{operationName}}\n    params\n        string  pLsEntrada   : in\n        string  pLsSaida     : out\n                \\$t_ds_erro\\$  : out\n    endparams\n    variables\n        string  vDsContexto\n    endvariables\n\n    vDsContexto = \"%%^<\\$componentname>, <\\$trigger>, {{operationName}}\"\n\n    ; Enter your code here...\n\n    return 0\nend ;{{operationName}}",
                    "description": "Multiline text used to generate a new operation. Supports {{operationName}}, {{author}}, {{date}}, and VS Code snippet placeholders."
                }
            }
        },
        "languages": [
            {
                "id": "uniface",
                "aliases": [
                    "Uniface",
                    "uniface"
                ],
                "extensions": [
                    ".uniface",
                    ".proc"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "commands": [
            {
                "command": "uniface-extension.operation",
                "title": "Uniface: Create new Operation"
            },
            {
                "command": "uniface-extension.entry",
                "title": "Uniface: Create new Entry"
            },
            {
                "command": "uniface.navigateToFunction",
                "title": "Uniface: Go to function"
            }
        ],
        "grammars": [
            {
                "language": "uniface",
                "scopeName": "source.uniface",
                "path": "./syntaxes/uniface.tmLanguage.json"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "unifaceSidebar",
                    "title": "Uniface",
                    "icon": "media/rocket.svg"
                }
            ]
        },
        "views": {
            "unifaceSidebar": [
                {
                    "id": "unifaceFunctions",
                    "name": "Function List",
                    "icon": "media/rocket.svg"
                }
            ]
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/eliangelap/uniface-syntax-extension.git"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "26.x",
        "@types/vscode": "^1.125.0",
        "@typescript-eslint/eslint-plugin": "8.65.0",
        "@typescript-eslint/parser": "8.65.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "esbuild": "0.28.1",
        "eslint": "10.7.0",
        "npm-run-all": "4.1.5",
        "prettier": "^3.9.6",
        "typescript": "6.0.3"
    },
    "publisher": "eliangela",
    "author": {
        "email": "eliangela@eliangela.dev.br",
        "name": "Eliangela"
    },
    "contributors": [
        {
            "name": "Eliangela Menezes Palharini Paes",
            "url": "https://github.com/eliangelap"
        },
        {
            "name": "Matheus Santos de Andrade",
            "url": "https://github.com/matheusa1"
        }
    ],
    "engines": {
        "vscode": "^1.125.0",
        "node": "24.14.0"
    },
    "dependencies": {
        "standard-version": "9.5.0"
    },
    "icon": "media/rocket.png",
    "activationEvents": []
}
